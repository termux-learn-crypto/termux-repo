#!/data/data/com.termux/files/usr/bin/bash
# plot-training [log.csv] [out.png]
#   CSV columns: epoch,loss[,val_loss,acc,val_acc...]  (header row required)
#   No CSV -> demo curves. PNG goes to ~/plots/ and opens with termux-open.
IN="${1:-}"; OUT="${2:-$HOME/plots/training.png}"; mkdir -p "$(dirname "$OUT")"
IN="$IN" OUT="$OUT" MPLBACKEND=Agg python - <<'PY'
import os, csv, numpy as np, matplotlib.pyplot as plt
src, out = os.environ["IN"], os.environ["OUT"]
if src:
    rows = list(csv.DictReader(open(src))); cols = list(rows[0].keys())
    x = [float(r[cols[0]]) for r in rows]; series = {c: [float(r[c]) for r in rows] for c in cols[1:]}
    xlabel = cols[0]
else:
    x = np.arange(1, 31); xlabel = "epoch"
    series = {"loss": 2.0*np.exp(-x/8)+0.1, "val_loss": 2.0*np.exp(-x/9)+0.18,
              "acc": 1-0.9*np.exp(-x/7), "val_acc": 1-0.9*np.exp(-x/8)-0.04}
loss = {k: v for k, v in series.items() if "loss" in k.lower()}
other = {k: v for k, v in series.items() if k not in loss}
n = 2 if loss and other else 1
fig, axes = plt.subplots(1, n, figsize=(6*n, 4)); axes = np.atleast_1d(axes)
for ax, group, title in zip(axes, [g for g in (loss, other) if g], ["Loss", "Metrics"] if loss else ["Metrics"]):
    for k, v in group.items(): ax.plot(x, v, label=k, marker="o", ms=3)
    ax.set_xlabel(xlabel); ax.set_title(title); ax.grid(alpha=.3); ax.legend()
fig.tight_layout(); fig.savefig(out, dpi=120); print("[+] saved", out)
PY
[ $? -eq 0 ] && command -v termux-open >/dev/null 2>&1 && termux-open "$OUT" 2>/dev/null || true
