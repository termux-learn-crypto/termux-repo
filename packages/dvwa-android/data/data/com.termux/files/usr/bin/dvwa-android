#!/data/data/com.termux/files/usr/bin/bash
# dvwa-android [--download-only|--force] : download the DVWA APK and open the Android installer
set -u
VER="2.1.1"
URL="https://github.com/termux-learn-crypto/dvwa-android/releases/download/v${VER}/dvwa-native-v${VER}-debug.apk"
DEST="$HOME/dvwa-android"; mkdir -p "$DEST"
APK="$DEST/dvwa-native-v${VER}-debug.apk"
if [ ! -s "$APK" ] || [ "${1:-}" = "--force" ]; then
  echo "[*] Downloading DVWA APK v$VER ..."
  curl -fL --progress-bar -o "$APK.part" "$URL" && mv "$APK.part" "$APK" || { rm -f "$APK.part"; echo "[x] Download failed" >&2; exit 1; }
fi
echo "[+] APK: $APK"
[ "${1:-}" = "--download-only" ] && exit 0
echo "[*] Opening Android installer (allow 'Install unknown apps' for Termux if asked)..."
termux-open "$APK"
