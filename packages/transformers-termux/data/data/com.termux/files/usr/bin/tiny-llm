#!/data/data/com.termux/files/usr/bin/bash
# tiny-llm "prompt" [model]  - run a small language model on CPU (default: HuggingFaceTB/SmolLM2-135M-Instruct, ~270 MB download once)
PROMPT="${1:-Namaste! Tell me one fun fact about Android.}"
MODEL="${2:-${TINY_LLM_MODEL:-HuggingFaceTB/SmolLM2-135M-Instruct}}"
PROMPT="$PROMPT" MODEL="$MODEL" python - <<'PY'
import os, torch
from transformers import AutoTokenizer, AutoModelForCausalLM
m = os.environ["MODEL"]; tok = AutoTokenizer.from_pretrained(m); model = AutoModelForCausalLM.from_pretrained(m)
msgs = [{"role": "user", "content": os.environ["PROMPT"]}]
ids = tok.apply_chat_template(msgs, add_generation_prompt=True, return_tensors="pt") if tok.chat_template else tok(os.environ["PROMPT"], return_tensors="pt").input_ids
with torch.no_grad():
    out = model.generate(ids, max_new_tokens=120, do_sample=True, temperature=0.7, top_p=0.9)
print(tok.decode(out[0][ids.shape[1]:], skip_special_tokens=True))
PY
