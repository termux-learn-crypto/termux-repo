#!/data/data/com.termux/files/usr/bin/sh
[ "$1" = configure ] || exit 0
if [ "${VS_SKIP_SETUP:-0}" != 1 ]; then
  bash /data/data/com.termux/files/usr/share/voicestudio/setup.sh \
    || echo "[!] VoiceStudio setup did not finish. Retry with: voicestudio-setup"
fi
echo "[voicestudio] Run: voicestudio   then open http://127.0.0.1:3900"
exit 0
