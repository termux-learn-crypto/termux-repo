#!/data/data/com.termux/files/usr/bin/bash
# voicestudio - start VoiceStudio (UI: http://127.0.0.1:3900)
APP_DIR="${VS_DIR:-$HOME/VoiceStudio}"
case "${1:-}" in
  update|--update|setup) exec voicestudio-setup ;;
  -h|--help) echo "Usage: voicestudio [update]   UI: http://127.0.0.1:3900"; exit 0 ;;
esac
[ -f "$APP_DIR/termux/run.sh" ] && [ -d "$APP_DIR/.venv-termux" ] || voicestudio-setup || exit 1
exec bash "$APP_DIR/termux/run.sh" "$@"
