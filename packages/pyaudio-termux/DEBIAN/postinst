#!/data/data/com.termux/files/usr/bin/sh
[ "$1" = configure ] || exit 0
if [ "${PYAUDIO_SKIP_SETUP:-0}" != 1 ]; then
  bash /data/data/com.termux/files/usr/share/pyaudio-termux/setup.sh \
    || echo "[!] PyAudio build failed. Fix and retry with: pyaudio-setup"
fi
echo "[pyaudio-termux] Ready. Run: start-audio ; pyaudio-test"
exit 0
