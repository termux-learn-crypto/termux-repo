# Simple Calculator - HinglishPy
kaam calc(a, b, op):
    match op:
        case "+":
            wapas a + b
        case "-":
            wapas a - b
        case "*":
            wapas a * b
        case "/":
            agar b == 0:
                wapas "NaT Karo!"
            wapas a / b
        case _:
            wapas "Galt op"

bolo "1 + 2 =", calc(1, 2, "+")
bolo "10 - 4 =", calc(10, 4, "-")
bolo "3 * 7 =", calc(3, 7, "*")
bolo "22 / 7 =", calc(22, 7, "/")
