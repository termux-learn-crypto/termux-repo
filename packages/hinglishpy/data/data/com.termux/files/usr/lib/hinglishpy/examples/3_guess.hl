# Number Guessing Game - HinglishPy
lao random

asli = random.randint(1, 20)
bolo "1 se 20 ke beech ka number soch liya..."
koshishen = 0
jabtak sahi:
    koshishen = koshishen + 1
    guess = sankhya(puchho("Guess karo: "))
    agar guess == asli:
        bolo f"Jeet gaye! {koshishen} koshish me solve kiya!"
        todo
    nahito guess < asli:
        bolo "Thoda bada number hai!"
    warna:
        bolo "Thoda chhota number hai!"
