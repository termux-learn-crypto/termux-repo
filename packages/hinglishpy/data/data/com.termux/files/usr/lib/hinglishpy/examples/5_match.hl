# match / case - HinglishPy
kaam describe_num(x):
    match x:
        case 0:
            wapas "sifr"
        case 1 | 2 | 3:
            wapas "chhota"
        case n agar n < 0:
            wapas "negative"
        case _:
            wapas "bada"

bolo describe_num(0)
bolo describe_num(2)
bolo describe_num(-5)
bolo describe_num(100)
