#!/data/data/com.termux/files/usr/bin/bash
python - <<'PY'
import trl, datasets, torch, transformers
from trl import SFTConfig, DPOConfig, SFTTrainer, DPOTrainer
cfg = SFTConfig(output_dir="trl-check-out", per_device_train_batch_size=1, max_length=64, use_cpu=True, report_to=[])
print(f"trl {trl.__version__} | datasets {datasets.__version__} | transformers {transformers.__version__} | torch {torch.__version__}")
print("SFTConfig ok:", cfg.per_device_train_batch_size, "batch, max_length", cfg.max_length)
PY
