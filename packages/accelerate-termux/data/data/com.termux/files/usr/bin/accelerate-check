#!/data/data/com.termux/files/usr/bin/bash
python - <<'PY'
import torch, torch.nn as nn
import accelerate
from accelerate import Accelerator
from torch.utils.data import DataLoader, TensorDataset

acc = Accelerator()
torch.manual_seed(0)
ds = TensorDataset(torch.randn(64, 8), torch.randn(64, 1))
model = nn.Sequential(nn.Linear(8, 16), nn.ReLU(), nn.Linear(16, 1))
model = acc.prepare(model)
dl = acc.prepare(DataLoader(ds, batch_size=16))
opt = acc.prepare(torch.optim.SGD(model.parameters(), lr=0.1))
loss_fn = nn.MSELoss()
for x, y in dl:
    opt.zero_grad()
    loss = loss_fn(model(x), y)
    acc.backward(loss)
    opt.step()
    break
print(f"accelerate {accelerate.__version__} | torch {torch.__version__} | device: {acc.device} | num_processes: {acc.num_processes}")
print(f"CPU training step ok, loss: {float(loss.detach()):.4f}")
PY
